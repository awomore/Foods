# Dependencies
node_modules/
.pnp
.pnp.js

# Environment — NEVER commit real .env files
.env
.env.local
.env.*.local
backend/.env
mobile/.env
# Allow example files
!backend/.env.example
!mobile/.env.example

# Build outputs
dist/
build/
.expo/
web-build/
.next/
admin/.next/

# Native
mobile/ios/
mobile/android/app/build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Expo
.expo-shared/

# Local dev artifacts
metro-qr.png
start-metro.bat
rider/package-lock.json

# phone-repair writes a JSON copy of every account row it deletes.
# That is personal data (names, emails, phone numbers) — never commit it.
backend/scripts/phone-repair-backup-*.json

# Netlify MCP deploy zips: they bundle the whole repo, .env files included
deploy-*.zip

# Google Play upload credential for eas submit — never commit
mobile/google-play-service-account.json
*-service-account*.json
